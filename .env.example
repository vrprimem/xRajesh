# Copy to .env.local for local development. Never commit real values.
# These belong to the SUPPLIER PORTAL's own Supabase project, not vrprime-hub's.

# Supabase project URL (Project Settings > API). Safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase publishable key, starts with sb_publishable_ (Project Settings > API keys).
# Safe to expose to the browser: Row Level Security decides what it can read.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase secret key, starts with sb_secret_. SERVER ONLY: used to create logins and suppliers.
# Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Public half of the push key pair (see SETUP.md, step 6). Safe to expose.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
